# Google Maps — restrict key to your domain in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini AI for Hemophilia Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL="file:./dev.db"

# Optional: session secret for journal/forum auth (change in production)
SESSION_SECRET=change_this_to_a_random_secret_in_production

# Contact form — Gmail SMTP (messages sent to hemobot@gmail.com)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=hemobot@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
CONTACT_TO=hemobot@gmail.com
